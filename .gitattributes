* text=auto eol=lf

# Windows script hosts want CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# VBA sources are edited in the VBE, which is CRLF-only.
*.bas  text eol=crlf
*.cls  text eol=crlf
*.frm  text eol=crlf
*.vb   text eol=crlf

# Never touch template binaries.
*.dotm binary
*.dot  binary
*.docm binary

# The compiled VBA project. Committed on purpose so CI can build releases
# without Word; see docs/DEVELOPING.md.
*.bin  binary
